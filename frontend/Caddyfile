# Локально: :80 (HTTP). Продакшен: chat.example.com (авто HTTPS).
{$CADDY_SITE_ADDRESS::80} {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options SAMEORIGIN
		# Базовий CSP для SPA + embed; API на тому ж origin через /api/*
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		-Server
	}

	root * /srv

	handle /api/* {
		reverse_proxy backend:8000 {
			flush_interval -1
			transport http {
				read_timeout 600s
				write_timeout 600s
			}
		}
	}

	handle /widget.js {
		header Cache-Control "public, max-age=3600"
		file_server
	}

	handle /embed.html {
		header Cache-Control "no-cache, no-store, must-revalidate"
		# Embed може відкриватись у iframe з LMS (інший origin).
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors *; base-uri 'self'"
		header -X-Frame-Options
		file_server
	}

	handle /demo-embed.html {
		file_server
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		try_files {path} {path}/ /index.html
		file_server
	}
}
